{
  "name": "ai-ux-qa-agent",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0; lefthook install",
    "dev": "./dev.sh",
    "dev:web": "pnpm --filter web dev",
    "dev:browser-worker": "pnpm --filter @ai-ux-qa/browser-worker dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:tailwind": "pnpm --filter web check:tailwind",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:tailwind",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter web e2e"
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "lefthook": "2.2.2"
  }
}
